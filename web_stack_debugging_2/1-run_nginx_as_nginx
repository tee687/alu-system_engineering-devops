#!/usr/bin/env bash
# Configures Nginx to run as the nginx user listening on port 8080

# Update nginx.conf to run user as nginx
sed -i 's/user www-data;/user nginx;/g' /etc/nginx/nginx.conf
sed -i 's/user root;/user nginx;/g' /etc/nginx/nginx.conf

# Update default site configuration to listen on port 8080
sed -i 's/listen 80;/listen 8080;/g' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:80;/listen \[::\]:8080;/g' /etc/nginx/sites-available/default

# Ensure nginx user exists
id nginx &>/dev/null || useradd -r nginx

# Restart Nginx service
service nginx restart
